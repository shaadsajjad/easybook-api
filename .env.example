NODE_ENV=development
PORT=4000

# Neon POOLED connection string (host contains -pooler), used at runtime.
# Keep ?sslmode=require, add &pgbouncer=true and &connect_timeout=15 (Neon can take a few
# seconds to wake up after idling). Remove channel_binding if present.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connect_timeout=15
# Neon DIRECT connection string (same host without -pooler), used by prisma migrate.
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=15

# Long random string, at least 32 characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# "*" is fine for a mobile client. Use a comma-separated list to restrict browsers.
CORS_ORIGIN=*

OPENROUTER_API_KEY=
# Comma-separated free models, tried in order (fallback when one is rate-limited).
OPENROUTER_MODELS=nvidia/nemotron-3.5-lightning:free,baidu/ernie-5.5-flash-preview:free,google/gemma-4-31b-it:free

BUSINESS_TIMEZONE=Asia/Dhaka
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
SLOT_INTERVAL_MINUTES=30
