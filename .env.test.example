# Used only by `npm test` and `npm run test:db:setup`.
# MUST point to a SEPARATE database (e.g. a Neon "test" branch). Tests delete all rows.
NODE_ENV=test
PORT=4001

DATABASE_URL=postgresql://USER:PASSWORD@ep-test-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@ep-test-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

JWT_SECRET=test-secret-that-is-at-least-32-characters-long
JWT_EXPIRES_IN=7d
# Low rounds keep tests fast; production uses 10+.
BCRYPT_ROUNDS=4

CORS_ORIGIN=*

# Tests always mock the AI provider. Never put a real key here.
GEMINI_API_KEY=test-key
GEMINI_MODEL=gemini-2.5-flash

BUSINESS_TIMEZONE=Asia/Dhaka
BUSINESS_OPEN_HOUR=9
BUSINESS_CLOSE_HOUR=18
SLOT_INTERVAL_MINUTES=30
